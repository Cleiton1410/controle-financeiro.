generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id       Int    @id @default(autoincrement())
  userId   Int?
  name     String
  category String
  date     String
  value    Float
  type     String
  user     User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("Transaction")
}

model Goal {
  id      Int    @id @default(autoincrement())
  userId  Int?
  name    String
  current Float  @default(0)
  target  Float
  user    User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  @@map("Goal")
}

model GoalContribution {
  id        Int      @id @default(autoincrement())
  goalId    Int
  userId    Int
  value     Float
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([goalId])
  @@index([userId])
  @@map("GoalContribution")
}

model Account {
  id      Int    @id @default(autoincrement())
  userId  Int?
  name    String
  type    String
  value   Float
  dueDate Int?
  user    User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("Account")
}

model Budget {
  id       Int    @id @default(autoincrement())
  userId   Int
  category String
  limit    Float
  period   String @default("monthly")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, category, period])
  @@index([userId])
  @@map("Budget")
}

model RecurringTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  category  String
  value     Float
  type      String
  frequency String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, active])
  @@map("RecurringTransaction")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  name         String
  plan         String        @default("basic")
  planStatus   String        @default("active")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]
  contributions GoalContribution[]
  accounts     Account[]
  budgets      Budget[]
  recurringTransactions RecurringTransaction[]
  @@map("User")
}
